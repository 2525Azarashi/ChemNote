{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "sh scripts/build.sh",
    "build:raw": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:chem": "node scripts/lint-chem.mjs",
    "lint:chem:fix": "node scripts/lint-chem.mjs --fix",
    "verify:format": "tsx scripts/verify-explanation-format.mjs",
    "verify:coverage": "tsx scripts/verify-subquestion-coverage.mjs",
    "verify:loss": "tsx scripts/verify-no-content-loss.mjs",
    "verify": "npm run verify:format && npm run verify:coverage && npm run verify:loss",
    "test:rules": "firebase emulators:exec --only firestore --project mntb-rules-test \"vitest run\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.24.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
