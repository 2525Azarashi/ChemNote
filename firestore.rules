rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // 設計方針（フレンド機能）
    // ===============================================================
    // Firestore のルールは「クエリ結果」ではなく「クエリが必ず条件を
    // 満たすと静的に証明できるか」で判定される。そのため
    //   query(friend_profiles, where('friendCode','==',code))
    // のような検索を許可するには friend_profiles 全体を読ませる必要が
    // あり、認証済みユーザーが全ユーザーのプロフィールを吸い出せてしまう。
    //
    // そこで「コード → uid」だけを持つ逆引きインデックス
    //   friend_codes/{friendCode}  ->  { uid }
    // を作り、コードを知っている人だけが get（単一ドキュメント取得）で
    // uid を引けるようにする。list は禁止するので総当り列挙はできない。
    //
    // 個人情報（nickname / photoURL）は friend_profiles に置き、
    // 「自分」か「自分のフレンド」か「自分と申請関係にある相手」だけが
    // 読めるようにする。
    // ===============================================================

    // ---------------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(docData) {
      return isAuthenticated() && request.auth.uid == docData.uid;
    }

    // 自分の friends 配下に相手が登録されているか（= フレンド関係にある）
    function isMyFriend(otherUid) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/friends/$(request.auth.uid)/items/$(otherUid));
    }

    // 申請ドキュメントID は必ず `${toUid}_${fromUid}` に固定する。
    // これにより「1組につき1申請」が保証され、重複申請やスパムを防げる。
    function requestIdMatches(requestId, fromUid, toUid) {
      return requestId == toUid + '_' + fromUid;
    }

    // fromUid → toUid への申請が存在するか
    function requestExists(fromUid, toUid) {
      return exists(/databases/$(database)/documents/friend_requests/$(toUid + '_' + fromUid));
    }

    // 申請が存在し、かつ承認の根拠として有効な状態か。
    //
    // 注意: トランザクション／バッチ内の get() は「コミット前の状態」を見る。
    // 承認処理が同一トランザクションで
    //   (1) status を accepted に更新
    //   (2) 双方の friends を作成
    // を行う場合、(2) の評価時点では status はまだ pending に見える。
    // 一方、承認を2段階（先に status 更新 → 後で friends 作成）で行う実装や
    // リトライ時には accepted が見える。両方を許容する。
    // rejected / canceled は承認の根拠にならないので除外する。
    function requestUsableForFriendship(fromUid, toUid) {
      return requestExists(fromUid, toUid)
        && get(/databases/$(database)/documents/friend_requests/$(toUid + '_' + fromUid))
             .data.status in ['pending', 'accepted'];
    }

    // ===============================================================
    // Collections
    // ===============================================================

    // ユーザープロフィール（本人のみ）
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // 個人ノート
    match /notes/{noteId} {
      allow read: if isDocOwner(resource.data);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isDocOwner(resource.data) && request.resource.data.uid == request.auth.uid;
      allow delete: if isDocOwner(resource.data);
    }

    // ============================================================
    // ランキング（リーダーボード）
    // ============================================================
    //
    // ★このブロックの設計方針（セキュリティ上の要所）★
    //
    // ランキングは `allow read: if true` で誰でも読める。
    // つまり「ここに書けた内容は全ユーザーに配信される」ことになる。
    // したがって書き込み側の検証を、フレンド系コレクションと同じ水準まで
    // 引き上げておく必要がある。以前は uid とスコアの範囲しか見ておらず、
    //   ・nickname / photoURL の型も長さも未検証
    //     → 数MBの文字列や不適切な表示名を全員の画面に載せられる
    //   ・フィールドの追加が自由
    //     → 想定外のデータを公開コレクションに置ける（保存領域の悪用）
    // という穴があった。
    //
    // 対策は次の3点。
    //   1. hasOnly() で許可フィールドを固定する（未知のフィールドを拒否）
    //   2. nickname / photoURL に型と長さの上限を課す
    //   3. 数値・タイムスタンプの型と範囲を明示する
    //
    // なお photoURL の上限を 512 にしているのは、Google アカウントの
    // アバターURL（lh3.googleusercontent.com/...）が十分収まる長さで、
    // かつデータURL等を押し込めない値として選んだもの。

    // 表示名の妥当性。フレンド系（friend_profiles など）と同じ 24 文字上限で揃える。
    function isValidRankingIdentity(data) {
      return data.nickname is string
        && data.nickname.size() > 0
        && data.nickname.size() <= 24
        && data.photoURL is string
        && data.photoURL.size() <= 512;
    }

    // 章ごとのベストスコア。ドキュメントID = `${chapterId}_${uid}`
    match /leaderboard_chapter/{docId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        // 書き込めるのは本人の行だけ（ID にも uid を含めて二重に縛る）
        && request.resource.data.uid == request.auth.uid
        && docId == request.resource.data.chapterId + '_' + request.auth.uid
        // 想定したフィールド以外は一切受け付けない
        && request.resource.data.keys().hasOnly([
             'uid', 'nickname', 'photoURL', 'chapterId', 'bestScore',
             'correctRate', 'totalCorrect', 'totalQuestions', 'timeUsedSec', 'playedAt'
           ])
        && request.resource.data.keys().hasAll([
             'uid', 'nickname', 'photoURL', 'chapterId', 'bestScore', 'playedAt'
           ])
        && isValidRankingIdentity(request.resource.data)
        && request.resource.data.chapterId is string
        && request.resource.data.chapterId.size() <= 64
        && request.resource.data.bestScore is number
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 1000000
        && request.resource.data.correctRate is number
        && request.resource.data.correctRate >= 0
        && request.resource.data.correctRate <= 1
        && request.resource.data.totalCorrect is number
        && request.resource.data.totalCorrect >= 0
        && request.resource.data.totalQuestions is number
        && request.resource.data.totalQuestions >= 0
        && request.resource.data.totalQuestions <= 10000
        && request.resource.data.timeUsedSec is number
        && request.resource.data.timeUsedSec >= 0
        && request.resource.data.playedAt is timestamp;
      allow delete: if false;
    }

    // 全章合計スコア。ドキュメントID = uid
    match /leaderboard_total/{uid} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
             'uid', 'nickname', 'photoURL', 'totalScore', 'chapterScores', 'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'uid', 'nickname', 'photoURL', 'totalScore', 'updatedAt'
           ])
        && isValidRankingIdentity(request.resource.data)
        && request.resource.data.totalScore is number
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= 100000000
        // chapterScores は { chapterId: score } のマップ。
        // 章数（化学基礎+化学発展）を大きく超える件数は入らないようにする。
        && request.resource.data.chapterScores is map
        && request.resource.data.chapterScores.size() <= 300
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // プレイ履歴（週間/月間ランキング集計用）。任意ドキュメントID。
    match /leaderboard_events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'uid', 'nickname', 'photoURL', 'chapterId', 'score',
             'correctRate', 'totalCorrect', 'totalQuestions', 'timeUsedSec', 'playedAt'
           ])
        && request.resource.data.keys().hasAll([
             'uid', 'nickname', 'photoURL', 'chapterId', 'score', 'playedAt'
           ])
        && isValidRankingIdentity(request.resource.data)
        && request.resource.data.chapterId is string
        && request.resource.data.chapterId.size() <= 64
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.correctRate is number
        && request.resource.data.correctRate >= 0
        && request.resource.data.correctRate <= 1
        && request.resource.data.totalCorrect is number
        && request.resource.data.totalCorrect >= 0
        && request.resource.data.totalQuestions is number
        && request.resource.data.totalQuestions >= 0
        && request.resource.data.totalQuestions <= 10000
        && request.resource.data.timeUsedSec is number
        && request.resource.data.timeUsedSec >= 0
        && request.resource.data.playedAt is timestamp;
      allow update, delete: if false;
    }

    // ============================================================
    // フレンドコード逆引きインデックス
    //   friend_codes/{friendCode} = { uid, nickname, photoURL, updatedAt }
    // ============================================================
    // - get のみ許可（コードを知っている人だけが uid を引ける）
    // - list は禁止 → コード一覧の列挙・総当り収集を防止
    // - 表示名を同梱するのは「申請前に相手を確認する」ため。コードを
    //   知らなければ到達できないので、プロフィール全体の露出にならない。
    // - 上書き（他人のコードの奪取）は禁止：既存ドキュメントの uid が
    //   自分自身でなければ update 不可
    function validCodeDoc() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'photoURL', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 24;
    }

    match /friend_codes/{friendCode} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
        && validCodeDoc()
        && friendCode.matches('^MNTB-[A-Z0-9]{4}-[A-Z0-9]{4}$');

      // 自分のコードの再保存のみ許可（uid は変更不可）
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && validCodeDoc();

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ============================================================
    // フレンドプロフィール（表示名・アイコン）
    //   friend_profiles/{uid} = { uid, nickname, photoURL, friendCode }
    // ============================================================
    // - 読めるのは「本人」「自分のフレンド」「自分と申請関係にある相手」のみ
    // - list は禁止 → 全ユーザーのプロフィール収集を防止
    // - 書き込みは本人のみ、uid の偽装も不可
    match /friend_profiles/{userId} {
      allow get: if isOwner(userId)
        || isMyFriend(userId)
        || (isAuthenticated() && requestExists(request.auth.uid, userId))
        || (isAuthenticated() && requestExists(userId, request.auth.uid));
      allow list: if false;

      allow create, update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 24;
      allow delete: if isOwner(userId);
    }

    // ============================================================
    // フレンド申請
    //   friend_requests/{toUid}_{fromUid}
    //     = { fromUid, toUid, fromNickname, fromPhotoURL, status,
    //         createdAt, updatedAt }
    //   status: "pending" | "accepted" | "rejected" | "canceled"
    // ============================================================
    match /friend_requests/{requestId} {
      // 当事者だけが読める。list は where で当事者を明示したクエリのみ通る。
      allow get, list: if isAuthenticated()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);

      // 申請の作成: 送信者本人のみ。ID を固定して重複申請を防ぐ。
      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestIdMatches(requestId, request.resource.data.fromUid, request.resource.data.toUid)
        && request.resource.data.keys().hasOnly(
             ['fromUid', 'toUid', 'fromNickname', 'fromPhotoURL', 'status',
              'createdAt', 'updatedAt'])
        && request.resource.data.fromNickname is string
        && request.resource.data.fromNickname.size() <= 24
        // 新規申請は必ず pending から始まる
        && request.resource.data.status == 'pending'
        // すでにフレンドなら申請不要
        && !isMyFriend(request.resource.data.toUid);

      // 状態遷移のみ許可する。当事者・遷移元・遷移先をすべて検証し、
      // fromUid / toUid の差し替えは禁止する。
      //   受信者: pending -> accepted | rejected
      //   送信者: pending -> canceled
      allow update: if isAuthenticated()
        // 当事者以外は触れない
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid)
        // 遷移元は必ず pending（承認済みを蒸し返せない）
        && resource.data.status == 'pending'
        // 変更できるのは status と updatedAt だけ
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && (
          // 受信者は承認 or 拒否
          (
            resource.data.toUid == request.auth.uid
            && request.resource.data.status in ['accepted', 'rejected']
          )
          // 送信者は取り消しのみ
          || (
            resource.data.fromUid == request.auth.uid
            && request.resource.data.status == 'canceled'
          )
        );

      // 削除できるのは当事者のみ（受信者=拒否/承認後の後片付け、送信者=取り消し）
      allow delete: if isAuthenticated()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // ============================================================
    // フレンド関係
    //   friends/{ownerUid}/items/{friendUid} = { uid, nickname, photoURL, addedAt }
    // ============================================================
    match /friends/{userId}/items/{friendUid} {
      // 自分のフレンド一覧のみ読める（他人の交友関係は見えない）
      allow read: if isOwner(userId);

      allow create: if isAuthenticated()
        && request.resource.data.uid == friendUid
        && friendUid != userId
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'photoURL', 'addedAt'])
        && (
          // (1) 受信者が承認する場合:
          //     自分の配下に「自分へ申請してきた相手」を登録する
          (
            request.auth.uid == userId
            && requestUsableForFriendship(friendUid, userId)
          )
          // (2) 承認の副作用として、申請してきた相手の配下に自分を登録する:
          //     「相手 → 自分」の申請が実在することを検証するので、
          //     無関係な他人の friends に勝手に割り込むことはできない。
          || (
            request.auth.uid == friendUid
            && requestUsableForFriendship(userId, friendUid)
          )
        );

      // 書き換えは (a) 自分の一覧の表示名リフレッシュ、または
      // (b) 承認処理の再実行（片側だけ既に存在していた場合）に限定。
      // uid の差し替えは常に禁止。
      allow update: if isAuthenticated()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'photoURL', 'addedAt'])
        && (
          isOwner(userId)
          || (request.auth.uid == friendUid && requestUsableForFriendship(userId, friendUid))
        );

      // 削除は「自分の一覧から消す」か「相手の一覧から自分を消す」のみ。
      // 第三者同士のフレンド関係には手を出せない。
      allow delete: if isAuthenticated()
        && (request.auth.uid == userId || request.auth.uid == friendUid);
    }

    // ============================================================
    // ユーザーフィードバック（ご意見・ご要望の投函箱）
    //   feedback/{docId}
    // ------------------------------------------------------------
    // 設計方針
    //  - ゲスト（未ログイン）でも送れるようにするため create は
    //    認証を要求しない。ただし「投函するだけ」に徹底して絞る。
    //  - read / update / delete は一切許可しない（allow を書かない）。
    //    運営は Firebase コンソールや Admin SDK から閲覧するため、
    //    クライアントに読み取り権限を与える必要がない。これにより
    //    他人の意見や連絡先メールアドレスを覗かれる余地をなくす。
    //  - スパムで課金が膨らまないよう、フィールド構成と本文長を厳格に検証する。
    // ============================================================
    match /feedback/{docId} {
      // 投函内容が想定どおりか検証する
      function isValidFeedback(data) {
        return data.keys().hasAll([
                 'id', 'screen', 'category', 'rating', 'message', 'uid', 'createdAt'
               ])
          && data.keys().hasOnly([
               'id', 'screen', 'category', 'rating', 'message', 'uid',
               'displayName', 'authEmail', 'contactEmail', 'context',
               'userAgent', 'viewport', 'appVersion', 'createdAtIso',
               'createdAt', 'status'
             ])
          // 送信元画面・種類は既知の値のみ
          && data.screen is string
          && data.screen in ['title', 'chapter_result', 'mock_exam_result', 'other']
          && data.category is string
          && data.category in ['praise', 'problem', 'bug', 'request', 'other']
          // 評価は 0〜5（0 = 未選択）
          && data.rating is int
          && data.rating >= 0 && data.rating <= 5
          // 本文は必須・空不可・2000文字以内（クライアント側の上限と一致）
          && data.message is string
          && data.message.size() > 0
          && data.message.size() <= 2000
          // 管理IDは短い文字列
          && data.id is string
          && data.id.size() > 0 && data.id.size() <= 80
          // uid は「本人の uid」か「null（ゲスト）」のみ。他人へのなりすまし防止。
          && (data.uid == null || (isAuthenticated() && data.uid == request.auth.uid))
          // 付帯情報の暴走を防ぐサイズ制限
          && (!('context' in data) || data.context == null
              || (data.context is map && data.context.keys().size() <= 20))
          && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 400))
          && (!('viewport' in data) || (data.viewport is string && data.viewport.size() <= 40))
          && (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 40))
          && (!('createdAtIso' in data) || (data.createdAtIso is string && data.createdAtIso.size() <= 40))
          && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
          && (!('authEmail' in data) || data.authEmail == null || (data.authEmail is string && data.authEmail.size() <= 200))
          && (!('contactEmail' in data) || data.contactEmail == null || (data.contactEmail is string && data.contactEmail.size() <= 200))
          // 新規投函は必ず status = 'new'（運営が Admin SDK 側で更新する）
          && (!('status' in data) || data.status == 'new')
          // 時刻はサーバー時刻のみ（端末時計の偽装で並び順を荒らせない）
          && data.createdAt == request.time;
      }

      // 投函のみ許可（ゲスト可）
      allow create: if isValidFeedback(request.resource.data);

      // クライアントからの閲覧・改変・削除は全面禁止
      allow read, update, delete: if false;
    }

    // ============================================================
    // 利用者台帳（app_users）
    // ============================================================
    // 目的：総ユーザー数と、登録されている Google アカウントの把握。
    //
    // 設計:
    //  - ドキュメントID = uid に固定し、1人1行にする。
    //    これにより getCountFromServer() の件数がそのまま「総ユーザー数」になる。
    //  - 書き込めるのは「自分の行」だけ。他人の行は作れも消せもしない。
    //    （フィードバックと違い匿名投函を許すと、
    //      いくらでも偽アカウントを増やせて総数が無意味になるため、
    //      ここは必ず認証を要求する。）
    //  - read は全面禁止。運営は Firebase コンソール／Admin SDK から見る。
    //    利用者が他人のメールアドレスを列挙できてはならない。
    //  - delete も禁止（数を勝手に減らされないようにする）。
    // ============================================================
    match /app_users/{userId} {
      function isValidUserRecord(data) {
        return data.keys().hasOnly([
                 'uid', 'isGoogleLinked', 'displayName', 'email', 'photoUrl',
                 'profileName', 'grade', 'streak', 'completedCount',
                 'createdAtIso', 'appVersion', 'userAgent',
                 'firstSeenAt', 'lastSeenAt', 'lastSeenIso'
               ])
          // uid はドキュメントIDかつ本人のものに限る（なりすまし防止）
          && data.uid is string
          && data.uid == userId
          && data.uid == request.auth.uid
          && data.isGoogleLinked is bool
          // 学習状況は非負の整数。異常値でグラフを壊されないよう上限も置く。
          && data.streak is int && data.streak >= 0 && data.streak <= 100000
          && data.completedCount is int && data.completedCount >= 0 && data.completedCount <= 100000
          // 文字列項目の長さ制限（ストレージの暴走防止）
          && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
          && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200))
          && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500))
          && (!('profileName' in data) || data.profileName == null || (data.profileName is string && data.profileName.size() <= 100))
          && (!('grade' in data) || data.grade == null || (data.grade is string && data.grade.size() <= 50))
          && (!('createdAtIso' in data) || data.createdAtIso == null || (data.createdAtIso is string && data.createdAtIso.size() <= 40))
          && (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 40))
          && (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 400))
          && (!('lastSeenIso' in data) || (data.lastSeenIso is string && data.lastSeenIso.size() <= 40))
          // 「最終利用」は必ずサーバー時刻（端末時計の偽装を防ぐ）
          && (!('lastSeenAt' in data) || data.lastSeenAt == request.time);
      }

      // 自分の行だけ作成・更新できる。
      //
      // ※ firstSeenAt の扱いに注意：
      //   更新時の request.resource.data は「書き込み後のドキュメント全体」なので、
      //   既存の firstSeenAt（過去の時刻）もそこに含まれる。
      //   そのため firstSeenAt == request.time を共通条件にすると
      //   2回目以降の更新が必ず拒否されてしまう。
      //   よって「作成時はサーバー時刻であること」だけを検証し、
      //   「更新時は改ざんされていないこと（＝値が変わらないこと）」を検証する。
      allow create: if isOwner(userId)
        && isValidUserRecord(request.resource.data)
        && (!('firstSeenAt' in request.resource.data)
            || request.resource.data.firstSeenAt == request.time);

      allow update: if isOwner(userId)
        && isValidUserRecord(request.resource.data)
        && (!('firstSeenAt' in request.resource.data)
            || request.resource.data.firstSeenAt == resource.data.firstSeenAt
            || !('firstSeenAt' in resource.data));

      // 閲覧・削除はクライアントからは不可（運営は管理コンソールから見る）
      allow read, delete: if false;
    }

    // ============================================================
    // 学習進捗の同期（study_progress）
    //   study_progress/{uid} = {
    //     uid, solved, reviewItems, solvedTotal, reviewTotal,
    //     lastStudiedAt, updatedAt
    //   }
    // ============================================================
    //
    // ■ これまでの問題
    //   学習進捗は端末の localStorage だけにあり、機種変更や
    //   キャッシュ削除で消えていた。また先生が生徒の状況を
    //   見る手段が原理的に存在しなかった。
    //
    // ■ 誰が読めるのか（ここが最重要）
    //   ① 生徒本人
    //   ② その生徒が「閲覧を許可した」先生だけ
    //
    //   ②の判定に study_access/{生徒uid}_{先生uid} の存在を使う。
    //   Firestore のルールには繰り返し処理が無く、「先生が担当する
    //   全クラスを走査して在籍を確認する」ことが書けないため、
    //   exists() 1回で判定できる形に落としてある。
    //
    // ■ list を禁止する理由
    //   list を許すと「全生徒の学習データを列挙するクエリ」が
    //   静的に否定できず、他人の進捗を吸い出せてしまう。
    //   先生は在籍者の uid を class_members から得て、
    //   1件ずつ get する（クライアント実装もそうしている）。
    // ============================================================
    match /study_progress/{userId} {
      function teacherHasAccess() {
        return isAuthenticated()
          && exists(/databases/$(database)/documents/study_access/$(userId + '_' + request.auth.uid));
      }

      function isValidProgress(data) {
        return data.keys().hasOnly([
                 'uid', 'solved', 'reviewItems',
                 'solvedTotal', 'reviewTotal', 'lastStudiedAt', 'updatedAt'
               ])
          // uid の偽装を防ぐ（他人の進捗として書き込めない）
          && data.uid is string
          && data.uid == userId
          && data.uid == request.auth.uid
          && data.solved is map
          && data.reviewItems is list
          // 復習リストは studySyncCore.MAX_SYNCED_REVIEW_ITEMS = 600 で
          // 上限を掛けている。ドキュメント1MiB制限に触れる前に弾く。
          && data.reviewItems.size() <= 600
          && (!('solvedTotal' in data) || (data.solvedTotal is int && data.solvedTotal >= 0))
          && (!('reviewTotal' in data) || (data.reviewTotal is int && data.reviewTotal >= 0))
          && (!('lastStudiedAt' in data) || data.lastStudiedAt is int)
          // 更新時刻は必ずサーバー時刻（端末時計の偽装を防ぐ）
          && (!('updatedAt' in data) || data.updatedAt == request.time);
      }

      allow get: if isOwner(userId) || teacherHasAccess();
      allow list: if false;

      // 書けるのは本人だけ。先生は読み取り専用（成績の書き換えを防ぐ）。
      allow create, update: if isOwner(userId) && isValidProgress(request.resource.data);

      // 削除は本人のみ（退会時に自分のデータを消せる状態を保つ）
      allow delete: if isOwner(userId);
    }

    // ============================================================
    // 学習データの閲覧許可（study_access）
    //   study_access/{生徒uid}_{先生uid} =
    //     { studentUid, teacherUid, classId, grantedAt }
    // ============================================================
    //
    // ■ 設計の意図：同意を仕組みで担保する
    //   このレコードを作れるのは **生徒本人だけ**。
    //   先生が勝手に作ることはできないので、
    //   「先生が無断で生徒のデータを見る」ことが原理的に起こらない。
    //   生徒がクラスに参加する行為が、そのまま閲覧許可になる。
    //
    //   学校へ提供する際に必ず問われる「誰が何を見られるのか」に
    //   仕組みで答えられるようにするための中核。
    // ============================================================
    match /study_access/{accessId} {
      // 当事者（生徒本人・許可された先生）だけが存在を確認できる
      allow get: if isAuthenticated()
        && (resource.data.studentUid == request.auth.uid
            || resource.data.teacherUid == request.auth.uid);
      allow list: if false;

      // 作成できるのは生徒本人のみ。
      // ドキュメントIDを `${studentUid}_${teacherUid}` に固定することで、
      // 中身とIDの食い違い（別人の許可をこっそり作る）を防ぐ。
      allow create, update: if isAuthenticated()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.teacherUid is string
        && request.resource.data.classId is string
        && accessId == request.resource.data.studentUid + '_' + request.resource.data.teacherUid;

      // 取り消せるのは生徒本人のみ（先生に許可を消させない＝
      // 生徒が抜けたのに許可だけ残る、の逆も防ぐ）
      allow delete: if isAuthenticated() && resource.data.studentUid == request.auth.uid;
    }

    // ============================================================
    // クラス（classrooms）
    //   classrooms/{classId} = {
    //     id, teacherUid, schoolName, className, joinCode,
    //     subject, joinOpen, memberCount, createdAt, updatedAt
    //   }
    // ============================================================
    //
    // ■ read を認証済み全員に許すのはなぜか
    //   生徒が参加コードを入力したとき、クラス名を表示して
    //   「この授業に参加しますか？」と確認させる必要がある。
    //   そのため get は許可する。ただし list は禁止するので、
    //   全国のクラスを列挙することはできない。
    //   （classrooms に個人情報は置かない設計にしてある）
    // ============================================================
    match /classrooms/{classId} {
      function isValidClassroom(data) {
        return data.keys().hasOnly([
                 'id', 'teacherUid', 'schoolName', 'className', 'joinCode',
                 'subject', 'joinOpen', 'memberCount', 'createdAt', 'updatedAt'
               ])
          && data.teacherUid is string
          && data.teacherUid == request.auth.uid
          && data.schoolName is string && data.schoolName.size() > 0 && data.schoolName.size() <= 40
          && data.className is string && data.className.size() > 0 && data.className.size() <= 40
          && data.joinCode is string && data.joinCode.matches('^[ACDEFGHJKMNPQRSTWXYZ2345679]{6}$')
          && data.subject in ['chemistry_basic', 'chemistry', 'english_listening']
          && data.joinOpen is bool;
      }

      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated() && isValidClassroom(request.resource.data);

      // 担任のみ更新可。teacherUid と joinCode は変更不可
      // （コードを差し替えて他クラスの生徒を奪えないようにする）
      allow update: if isAuthenticated()
        && resource.data.teacherUid == request.auth.uid
        && isValidClassroom(request.resource.data)
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.joinCode == resource.data.joinCode;

      allow delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }

    // ============================================================
    // 参加コードの逆引き（class_codes）
    //   class_codes/{joinCode} = { classId, teacherUid, createdAt }
    // ============================================================
    //
    // friend_codes と同じ発想。ルールは「クエリ結果」ではなく
    // 「クエリが必ず条件を満たすと静的に証明できるか」で判定されるため、
    // where('joinCode','==',x) を許すと classrooms 全体を読ませることに
    // なる。コードを知っている人だけが get できる形にし、list は禁止して
    // 総当りによる列挙を防ぐ。
    // ============================================================
    match /class_codes/{joinCode} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
        && joinCode.matches('^[ACDEFGHJKMNPQRSTWXYZ2345679]{6}$')
        && request.resource.data.keys().hasOnly(['classId', 'teacherUid', 'createdAt'])
        && request.resource.data.classId is string
        && request.resource.data.teacherUid == request.auth.uid;

      // 既にあるコードは奪えない（別の先生が上書きして
      // 生徒の参加先をすり替えることを防ぐ）
      allow update: if isAuthenticated()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid;

      allow delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }

    // ============================================================
    // 在籍（class_members）
    //   class_members/{classId}_{生徒uid} =
    //     { classId, uid, displayName, rosterName?, joinedAt, updatedAt? }
    // ============================================================
    //
    // ■ ドキュメントIDを固定する理由
    //   `${classId}_${uid}` に固定することで「1クラス1生徒1行」が
    //   保証され、同じ生徒が二重に在籍することがなくなる。
    //   friend_requests で同じ手法を使っており、実績がある。
    //
    // ■ list を許可している理由（ここだけ例外）
    //   先生が在籍者一覧を取るには where('classId','==',x) の
    //   クエリが必要になる。classId を知っているのは
    //   担任と在籍生徒だけなので、これは許容できる。
    //   在籍レコードには表示名しか無く、学習データは含まれない。
    // ============================================================
    match /class_members/{memberId} {
      function isValidMember(data) {
        return data.keys().hasOnly(['classId', 'uid', 'displayName', 'rosterName', 'joinedAt', 'updatedAt'])
          && data.classId is string
          && data.uid is string
          && data.displayName is string && data.displayName.size() <= 24
          && (!('rosterName' in data) || (data.rosterName is string && data.rosterName.size() <= 24))
          && memberId == data.classId + '_' + data.uid;
      }

      // 担任か本人が読める。
      // 担任判定はクラスを1回 get するだけで済む。
      function isClassTeacher(classId) {
        return isAuthenticated()
          && exists(/databases/$(database)/documents/classrooms/$(classId))
          && get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherUid == request.auth.uid;
      }

      allow get, list: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isClassTeacher(resource.data.classId));

      // 参加するのは生徒本人のみ（先生が生徒を勝手に登録できない）
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && isValidMember(request.resource.data);

      // 更新は
      //   ・本人（表示名の変更）
      //   ・担任（rosterName = 出席番号などの設定）
      // のみ。uid / classId は変更不可。
      allow update: if isAuthenticated()
        && isValidMember(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.classId == resource.data.classId
        && (resource.data.uid == request.auth.uid || isClassTeacher(resource.data.classId));

      // 退出は本人、除籍は担任
      allow delete: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isClassTeacher(resource.data.classId));
    }
  }
}
