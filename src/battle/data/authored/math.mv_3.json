      "format": "choice4",
      "prompt": "A(1, 2)、B(4, 8) のとき、AB を 2:1 に外分する点の座標はどれか。",
      "label": "",
      "options": [
        {
          "text": "(7, 14)",
          "correct": true,
          "why": "2:(-1) の内分とみて (2·4 - 1, 2·8 - 2) = (7, 14)。分母は 2-1 = 1。"
        },
        {
          "text": "(3, 6)",
          "why": "2:1 の内分点。外分点は線分の外側に来る。"
        },
        {
          "text": "(-2, -4)",
          "why": "反対側に外分した形。2:1 の外分は B より先に出る。"
        },
        {
          "text": "分母を 3 として計算した (7/3, 14/3)",
          "why": "外分の分母は m - n = 1。3 で割ると内分の分母になる。"
        }
      ],
      "oneLine": "(7, 14)。外分の分母は 2-1 = 1。B より外側に出る。",
      "timeLimit": 22
    },
