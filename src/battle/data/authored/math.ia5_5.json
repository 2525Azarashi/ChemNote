    {
      "id": "a:ia5_5:q_iad_115:q_iad_115_1:1",
      "source": {
        "chapterId": "ia5_5",
        "problemId": "q_iad_115",
        "subQuestionId": "q_iad_115_1"
      },
      "format": "choice4",
      "prompt": "白玉6個・赤玉 n 個の袋から2個を同時に取り出すとき、白1個・赤1個である確率 pₙ を n で表すと？",
      "label": "",
      "options": [
        {
          "text": "12n/((n+5)(n+6))",
          "correct": true,
          "why": "pₙ＝₆C₁·ₙC₁/ₙ₊₆C₂＝6n÷((n＋6)(n＋5)/2)＝12n/((n＋5)(n＋6))。"
        },
        {
          "text": "6n/((n+5)(n+6))",
          "why": "ₙ₊₆C₂＝(n＋6)(n＋5)/2 の「÷2」で分子が 2 倍になる。"
        },
        {
          "text": "12n/(n+6)²",
          "why": "2 個同時に取り出すので分母は (n＋6)(n＋5)/2。(n＋6)² ではない。"
        },
        {
          "text": "6/(n+6)",
          "why": "1 個取り出すときに白が出る確率。2 個取り出して白赤 1 個ずつの確率ではない。"
        }
      ],
      "oneLine": "12n/((n+5)(n+6))。pₙ＝₆C₁·ₙC₁/ₙ₊₆C₂＝6n÷((n＋6)(n＋5)/2)＝12n/((n＋5)(n＋6))。",
      "timeLimit": 20
    },
    {
      "id": "a:ia5_5:q_iad_115:q_iad_115_2:1",
      "source": {
        "chapterId": "ia5_5",
        "problemId": "q_iad_115",
        "subQuestionId": "q_iad_115_2"
      },
      "format": "choice4",
      "prompt": "白玉6個・赤玉 n 個（n≧1）の袋から2個同時に取り出し、白1個・赤1個である確率を pₙ とする。pₙ を最大にする n は？",
      "label": "",
      "options": [
        {
          "text": "n=5, 6",
          "correct": true,
          "why": "pₙ₊₁/pₙ＝(n＋1)(n＋5)/(n(n＋7))。"
        },
        {
          "text": "n=5 のみ",
          "why": "n＝5 のとき pₙ₊₁/pₙ＝1 なので p₅＝p₆。n＝6 も最大。"
        },
        {
          "text": "n=6 のみ",
          "why": "p₅＝p₆ なので n＝5 も最大になる。"
        },
        {
          "text": "n=4, 5",
          "why": "n＝4 のとき比は 1 より大きく p₄ ＜ p₅。最大は n＝5, 6。"
        }
      ],
      "oneLine": "n=5, 6。pₙ₊₁/pₙ＝(n＋1)(n＋5)/(n(n＋7))。",
      "timeLimit": 30
    }
  ]
